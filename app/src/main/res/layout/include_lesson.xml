<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="5dp"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:clipToOutline="false"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_corners"
        android:backgroundTint="@color/white"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:elevation="2dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:clipToOutline="false"
        >

        <TextView
            android:id="@+id/lesson_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="-"
            android:fontFamily="@font/inter_black"
            android:textSize="40sp"
            android:textColor="@color/yellow3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/line_note"
            app:layout_constraintLeft_toLeftOf="parent"
            />
        <TextView
            android:id="@+id/lesson_subgroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal|bottom"
            android:includeFontPadding="false"
            android:text="-"
            android:fontFamily="@font/inter_black"
            android:textSize="25sp"
            android:textColor="@color/grey4"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toTopOf="@id/lesson_count"
            app:layout_constraintBottom_toBottomOf="@+id/lesson_count"
            app:layout_constraintLeft_toRightOf="@+id/lesson_count"
            />

        <TextView
            android:id="@+id/lesson_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="40dp"
            android:fontFamily="@font/inter_black"
            android:text="Занятия нет"
            android:textColor="@color/black"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="01sp"
            android:autoSizeMaxTextSize="15sp"
            android:maxLines="2"
            android:gravity="left|center_vertical"
            android:paddingTop="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/lesson_teacher"
            app:layout_constraintEnd_toStartOf="@+id/lesson_time"
            app:layout_constraintStart_toEndOf="@+id/lesson_subgroup"
            />

        <TextView
            android:id="@+id/lesson_teacher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="12sp"
            android:textColor="@color/grey4"
            android:fontFamily="@font/inter_black"
            android:layout_marginStart="15dp"
            android:paddingBottom="10dp"
            app:layout_constraintTop_toBottomOf="@+id/lesson_name"
            app:layout_constraintBottom_toTopOf="@+id/line_note"
            app:layout_constraintStart_toEndOf="@+id/lesson_subgroup"
            />
        <TextView
            android:id="@+id/lesson_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:fontFamily="@font/inter_black"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/lesson_type"
            />
        <TextView
            android:id="@+id/lesson_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/grey4"
            android:fontFamily="@font/inter_medium"
            app:layout_constraintTop_toBottomOf="@+id/lesson_time"
            app:layout_constraintBottom_toTopOf="@+id/lesson_room"
            app:layout_constraintRight_toRightOf="parent"
            />
        <TextView
            android:id="@+id/lesson_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/grey4"
            android:fontFamily="@font/inter_medium"
            app:layout_constraintTop_toBottomOf="@+id/lesson_type"
            app:layout_constraintBottom_toTopOf="@+id/line_note"
            app:layout_constraintRight_toRightOf="parent"
            />

        <ImageView
            android:visibility="gone"
            android:id="@+id/line_note"
            android:layout_height="2dp"
            android:layout_width="match_parent"
            android:background="@drawable/rounded_corners"
            android:backgroundTint="@color/yellow3"
            android:layout_marginTop="5dp"
            android:layout_marginHorizontal="-5dp"
            app:layout_constraintTop_toBottomOf="@id/lesson_room"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <TextView
            android:visibility="gone"
            android:id="@+id/note_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/grey6"
            android:paddingHorizontal="10dp"
            android:paddingTop="5dp"
            app:layout_constraintTop_toBottomOf="@id/line_note"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
        <TextView
            android:visibility="gone"
            android:id="@+id/note_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="*"
            android:gravity="end|center_vertical"
            android:includeFontPadding="false"
            android:textSize="20sp"
            android:fontFamily="@font/inter_black"
            android:textColor="@color/yellow3"
            app:layout_constraintTop_toBottomOf="@id/line_note"
            app:layout_constraintEnd_toEndOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>