<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/alert_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/grey6_alpha_0.50"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/alert_body"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/alert_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingHorizontal="25dp"
        android:paddingBottom="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <LinearLayout
            android:id="@+id/alert_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="15dp"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <ImageView
                android:layout_width="45dp"
                android:layout_height="3dp"
                android:background="@drawable/rounded_corners"
                android:backgroundTint="@color/grey4"
                />

        </LinearLayout>


        <TextView
            android:id="@+id/alert_mainText"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:text="—"
            android:paddingHorizontal="25dp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:gravity="center_vertical|start"
            android:fontFamily="@font/inter_black"
            app:layout_constraintTop_toBottomOf="@id/alert_line"
            app:layout_constraintBottom_toTopOf="@+id/alert_extraText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"

            />
        <TextView
            android:id="@+id/alert_extraText"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:text="—"
            android:paddingHorizontal="25dp"
            android:maxLines="3"
            android:gravity="start|top"
            android:fontFamily="@font/inter_medium"
            android:textSize="15dp"
            app:layout_constraintTop_toBottomOf="@id/alert_mainText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
        <EditText
            android:id="@+id/alert_editText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:text=""
            android:hint="Текст заметки"
            android:textColorHint="@color/grey2"
            android:textColor="@color/grey6"
            android:maxLines="10"
            android:gravity="start|top"
            android:padding="15dp"
            android:background="@drawable/rounded_border"
            app:layout_constraintTop_toBottomOf="@id/alert_extraText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <TextView
            android:id="@+id/alert_deleteButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Удалить"
            android:textColor="@color/grey6"
            android:fontFamily="@font/inter_black"
            android:gravity="center"
            android:paddingVertical="15dp"
            android:background="@drawable/rounded_border"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="5dp"
            app:layout_constraintTop_toBottomOf="@+id/alert_editText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/alert_saveButton"
            />

        <TextView
            android:id="@+id/alert_saveButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Сохранить"
            android:textColor="@color/white"
            android:fontFamily="@font/inter_black"
            android:gravity="center"
            android:paddingVertical="15dp"
            android:background="@drawable/rounded_border"
            android:backgroundTint="@color/grey6"
            android:layout_marginTop="15dp"
            android:layout_marginStart="5dp"
            app:layout_constraintTop_toBottomOf="@+id/alert_editText"
            app:layout_constraintStart_toEndOf="@+id/alert_deleteButton"
            app:layout_constraintEnd_toEndOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>