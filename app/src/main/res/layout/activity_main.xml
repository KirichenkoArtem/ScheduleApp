<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/include_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/include_header"
            />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/grey0.25"
            >
        </androidx.fragment.app.FragmentContainerView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/bottom_nav_menu"
            android:background="@color/white"
            app:itemIconTint="@color/bottom_menu_colors"
            app:itemTextColor="@color/bottom_menu_colors"
            app:labelVisibilityMode="labeled"
            />

    </LinearLayout>

    <!-- alert_change_note поверх всего, но не выше загрузки -->
    <LinearLayout
        android:visibility="gone"
        android:id="@+id/alert_change_note"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <ImageView
            android:id="@+id/alert_change_background"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/grey6_alpha_0.50"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/alert_change_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingHorizontal="25dp"
            android:paddingBottom="15dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <LinearLayout
                android:id="@+id/alert_change_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                >

                <ImageView
                    android:layout_width="45dp"
                    android:layout_height="3dp"
                    android:background="@drawable/rounded_corners"
                    android:backgroundTint="@color/grey4"
                    />

            </LinearLayout>


            <TextView
                android:id="@+id/alert_change_mainText"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:paddingHorizontal="10dp"
                android:autoSizeTextType="uniform"
                android:maxLines="1"
                android:gravity="center_vertical|start"
                android:fontFamily="@font/inter_black"
                android:textColor="@color/grey6"
                app:layout_constraintTop_toBottomOf="@id/alert_change_line"
                app:layout_constraintBottom_toTopOf="@+id/alert_change_extraText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"

                />
            <TextView
                android:id="@+id/alert_change_extraText"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:paddingHorizontal="10dp"
                android:maxLines="3"
                android:gravity="start|top"
                android:fontFamily="@font/inter_medium"
                android:textSize="15dp"
                android:textColor="@color/grey4"
                app:layout_constraintTop_toBottomOf="@id/alert_change_mainText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <EditText
                android:id="@+id/alert_change_editText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:hint="Текст заметки"
                android:textColorHint="@color/grey2"
                android:textColor="@color/grey6"
                android:maxLines="10"
                android:gravity="start|top"
                android:padding="15dp"
                android:background="@drawable/rounded_border"
                app:layout_constraintTop_toBottomOf="@id/alert_change_extraText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <TextView
                android:id="@+id/alert_change_deleteButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Удалить"
                android:textColor="@color/grey6"
                android:fontFamily="@font/inter_black"
                android:gravity="center"
                android:paddingVertical="15dp"
                android:background="@drawable/rounded_border"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="5dp"
                app:layout_constraintTop_toBottomOf="@+id/alert_change_editText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/alert_change_saveButton"
                />

            <TextView
                android:id="@+id/alert_change_saveButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Сохранить"
                android:textColor="@color/white"
                android:fontFamily="@font/inter_black"
                android:gravity="center"
                android:paddingVertical="15dp"
                android:background="@drawable/rounded_border"
                android:backgroundTint="@color/grey6"
                android:layout_marginTop="15dp"
                android:layout_marginStart="5dp"
                app:layout_constraintTop_toBottomOf="@+id/alert_change_editText"
                app:layout_constraintStart_toEndOf="@+id/alert_change_deleteButton"
                app:layout_constraintEnd_toEndOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </LinearLayout>

    <!-- alert_note поверх всего, но не выше загрузки -->
    <LinearLayout
        android:visibility="gone"
        android:id="@+id/alert_add_note"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <ImageView
            android:id="@+id/alert_add_background"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/grey6_alpha_0.50"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/alert_add_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingHorizontal="25dp"
            android:paddingBottom="15dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <LinearLayout
                android:id="@+id/alert_add_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                >

                <ImageView
                    android:layout_width="45dp"
                    android:layout_height="3dp"
                    android:background="@drawable/rounded_corners"
                    android:backgroundTint="@color/grey4"
                    />

            </LinearLayout>

            <EditText
                android:id="@+id/alert_add_mainEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:text=""
                android:hint="Название заметки"
                android:textColorHint="@color/grey2"
                android:textColor="@color/grey6"
                android:maxLines="10"
                android:gravity="start|top"
                android:layout_marginTop="10dp"
                android:padding="15dp"
                android:background="@drawable/rounded_border"
                app:layout_constraintTop_toBottomOf="@id/alert_add_line"
                app:layout_constraintBottom_toTopOf="@+id/alert_add_valueEditText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <EditText
                android:id="@+id/alert_add_valueEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:text=""
                android:hint="Текст заметки"
                android:textColorHint="@color/grey2"
                android:textColor="@color/grey6"
                android:maxLines="10"
                android:gravity="start|top"
                android:layout_marginTop="15dp"
                android:padding="15dp"
                android:background="@drawable/rounded_border"
                app:layout_constraintTop_toBottomOf="@id/alert_add_mainEditText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <TextView
                android:id="@+id/alert_add_exitButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Забыть"
                android:textColor="@color/grey6"
                android:fontFamily="@font/inter_black"
                android:gravity="center"
                android:paddingVertical="15dp"
                android:background="@drawable/rounded_border"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="5dp"
                app:layout_constraintTop_toBottomOf="@+id/alert_add_valueEditText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/alert_add_saveButton"
                />

            <TextView
                android:id="@+id/alert_add_saveButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Сохранить"
                android:textColor="@color/white"
                android:fontFamily="@font/inter_black"
                android:gravity="center"
                android:paddingVertical="15dp"
                android:background="@drawable/rounded_border"
                android:backgroundTint="@color/grey6"
                android:layout_marginTop="15dp"
                android:layout_marginStart="5dp"
                app:layout_constraintTop_toBottomOf="@+id/alert_add_valueEditText"
                app:layout_constraintStart_toEndOf="@+id/alert_add_exitButton"
                app:layout_constraintEnd_toEndOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </LinearLayout>

    <!-- loading_indicator поверх всего -->
    <include
        android:visibility="gone"
        android:id="@+id/loading_indicator"
        layout="@layout/include_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>
