<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="75dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/grey6"
    android:paddingHorizontal="15dp"
    >

    <TextView
        android:id="@+id/headerGroupName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Кс-26-1_2"
        android:textSize="25sp"
        android:fontFamily="@font/inter_black"
        android:textColor="@color/white"
        android:layout_marginBottom="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
    <TextView
        android:id="@+id/headerExtraText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Расписание на сегодня"
        android:textSize="15sp"
        android:fontFamily="@font/inter_black"
        android:textColor="@color/grey3"
        android:layout_marginBottom="15dp"
        app:layout_constraintTop_toBottomOf="@+id/headerGroupName"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <LinearLayout
        android:id="@+id/headerLLButtons"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <ImageView
            android:id="@+id/headerGroupSetButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle"
            android:src="@drawable/ic_change_group"
            android:padding="7dp"
            android:backgroundTint="@color/grey4"
            android:layout_marginHorizontal="5dp"
            app:tint="@color/yellow3" />
        <ImageView
            android:id="@+id/headerUpdateButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle"
            android:src="@drawable/update_icon"
            android:padding="5dp"
            android:backgroundTint="@color/grey4"
            android:layout_marginHorizontal="5dp"
            app:tint="@color/yellow3" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>